# ==============================================================================
# nanit-proxy Configuration
# ==============================================================================

# Nanit Authentication
# Run `nanit-proxy auth` (or `docker run -it --rm nanit-proxy auth`) to generate a refresh token.
NANIT_REFRESH_TOKEN=4eaa5af7db14a34773348bc476a9f5cfd7f37e68f9bf81bb

# Streaming Configuration
# The LAN host:port where your RTMP receiver (e.g. go2rtc or MediaMTX) listens for incoming streams.
# The Nanit camera will be commanded to push its H.264/AAC feed directly to this address.
NANIT_RTMP_ADDR=192.0.2.10:1935

# Camera Selection (optional; auto-detected if only one camera is on the account)
# NANIT_BABY_UID=423c8a1e-0123-4567-89ab-cdef01234567

# Home Assistant MQTT Auto-Discovery & Telemetry
NANIT_MQTT_ENABLED=true
NANIT_MQTT_BROKER_URL=mqtt://192.0.2.10:1883
NANIT_MQTT_PREFIX=homeassistant
NANIT_MQTT_CLIENT_ID=nanit-proxy
# NANIT_MQTT_USERNAME=homeassistant
# NANIT_MQTT_PASSWORD=secret_password

# Custom Device Label & Temperature Units
NANIT_DEVICE_NAME="Nursery Nanit Camera"
NANIT_TEMP_UNIT=f # 'f' for Fahrenheit, 'c' for Celsius
